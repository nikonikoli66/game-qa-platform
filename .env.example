# ============ 数据存储 ============
# 默认 SQLite，零配置即可跑通；要用 MySQL 改成：
# QA_DB_URL=mysql://root:password@127.0.0.1:3306/game_qa
QA_DB_URL=sqlite:///data/app.db

# ============ 被测游戏服（Mock） ============
GAME_API_BASE=http://127.0.0.1:8000
MOCK_PORT=8000
# 异步奖励延迟秒数，用于验证「异步轮询断言」
MOCK_REWARD_DELAY=1.5
# 注入缺陷，用于演示自动化脚本能抓到真实 bug（留空则全部正常）
# 可选：gacha_pity_off_by_one, reward_double_claim, stamina_cost_mismatch
MOCK_BUGS=gacha_pity_off_by_one,reward_double_claim

# ============ 大模型 ============
# offline = 内置规则引擎，无 Key 也能完整跑通全流程
# 其它任意值 = 走 OpenAI 兼容协议（deepseek / openai / aliyun-maas / 自建网关 都行）
LLM_PROVIDER=offline
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
# 推理模型（deepseek-v4 系列）会先输出 reasoning_content，给小了会出现"正文为空"，务必给足
LLM_MAX_TOKENS=8192

# --- 示例：阿里云百炼（MAAS）OpenAI 兼容端点 ---
# LLM_PROVIDER=aliyun-maas
# LLM_API_KEY=sk-ws-xxxx
# LLM_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=deepseek-v4.1-flash     # 实测最稳：10/10 有效、均分 100、26s
# LLM_MODEL=qwen-plus               # 备选：8/10 有效、~90s
#
# --- 示例：DeepSeek ---
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-xxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ============ 执行引擎 ============
ASYNC_REWARD_SLA=8
QA_HTTP_TIMEOUT=10
SCRIPT_TIMEOUT=180
MAX_HEAL_ROUNDS=2

# ============ 用例质量门禁 ============
CASE_DEDUP_THRESHOLD=0.85
MIN_CASE_SCORE=75
